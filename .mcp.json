{
  "mcpServers": {
    "kb-writer": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/index.ts"
      ],
      "env": {
        "KB_WRITER_API_BASE_URL": "${KB_WRITER_API_BASE_URL}",
        "KB_WRITER_ACCESS_TOKEN": "${KB_WRITER_ACCESS_TOKEN}"
      }
    }
  }
}
